{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Invoker Emulator",
  "version": "0.1.0",
  "identifier": "com.invoker.emulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "卡尔练习器 / Invoker Emulator",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Dota 2 Invoker practice tool",
    "longDescription": "Offline Dota 2 Invoker practice tool with combo training.",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
